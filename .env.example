# nik8 configuration: one file for the Rust workspace and the mobile app.
#
#   cp .env.example .env
#   ln -s ../.env nik8-mobile/.env     # the app reads this same file
#
# Only EXPO_PUBLIC_* values are compiled into the app (and anyone with the APK can
# extract them). Never give a secret that prefix. Everything else stays on your machine.
#
# Pick one cluster and use it everywhere below. The Nik8 program has the same ID
# (NiK8BGgPDKystF2Azoj87yQM7VS6wcYzmm48ynjRHTU) on devnet and testnet.
#   devnet:  Seeker/MWA wallets support it; Yellowstone gRPC is a paid add-on (e.g. Helius).
#   testnet: free Yellowstone gRPC (PublicNode); some mobile wallets don't support testnet,
#            so fund the app's session key from the CLI instead of the wallet.

# --- Solana RPC -------------------------------------------------------------------
# Used by sender (leader schedule, cluster nodes, slots) and the live tests.
# Public endpoints work but are rate limited:
#   https://api.devnet.solana.com  |  https://api.testnet.solana.com
RPC_URL=https://api.devnet.solana.com
# Optional: slot-update WebSocket. Derived from RPC_URL when unset (https -> wss).
# WS_URL=

# Funded keypair for the live tests (path relative to this file; accounts/ is gitignored).
#   solana-keygen new -o accounts/payer-keypair.json
#   solana airdrop 2 accounts/payer-keypair.json --url devnet
PAYER_KEYPAIR=accounts/payer-keypair.json

# Optional: a different Nik8 program deployment.
# NIK8_PROGRAM_ID=NiK8BGgPDKystF2Azoj87yQM7VS6wcYzmm48ynjRHTU

# --- Yellowstone gRPC (receiving voice) -------------------------------------------
# Used by the consumer CLI, the live tests and the app. Must be on the RPC_URL cluster.
#   devnet:  https://laserstream-devnet-ewr.helius-rpc.com   token = Helius API key
#   testnet: https://solana-testnet-yellowstone-grpc.publicnode.com:443   token from publicnode.com
NIK8_GRPC_ENDPOINT=
NIK8_GRPC_X_TOKEN=

# --- sender ingress (optional; without it voice is sent through RPC) -------------
# Run sender (cargo run -p nik8_sender from sender/), then point the app at it.
# The app pins the ingress certificate by SHA-256, so a self-signed one is fine:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 365 \
#     -subj "/CN=nik8-ingress" -addext "subjectAltName=IP:<your-ip>,IP:127.0.0.1,DNS:localhost" \
#     -keyout certs/ingress-key.pem -out certs/ingress-cert.pem
#   openssl x509 -in certs/ingress-cert.pem -outform DER | sha256sum
NIK8_WEBTRANSPORT_CERT_PEM=../certs/ingress-cert.pem
NIK8_WEBTRANSPORT_KEY_PEM=../certs/ingress-key.pem
# NIK8_WEBTRANSPORT_PORT=4433
# Where clients reach it, e.g. https://192.168.1.40:4433 on your LAN. Leave empty for RPC only.
NIK8_INGRESS_URL=
NIK8_INGRESS_CERT_SHA256=

# --- App (nik8-mobile) --------------------------------------------------------------
# devnet | testnet. Restart Metro with --clear after changing anything here.
EXPO_PUBLIC_NIK8_CLUSTER=devnet
# These reference the values above; no need to edit them.
EXPO_PUBLIC_NIK8_GRPC_ENDPOINT=${NIK8_GRPC_ENDPOINT}
EXPO_PUBLIC_NIK8_GRPC_TOKEN=${NIK8_GRPC_X_TOKEN}
EXPO_PUBLIC_NIK8_INGRESS_URL=${NIK8_INGRESS_URL}
EXPO_PUBLIC_NIK8_INGRESS_CERT_SHA256=${NIK8_INGRESS_CERT_SHA256}
